# ==============================================================================
# AI Translation PoC — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==============================================================================

# DashScope API — INTERNATIONAL key (dashscope-intl.aliyuncs.com)
# WARNING: China-region key (from dashscope.aliyun.com) returns a cryptic 401
#          with no explanation. Use ONLY the international key.
# Obtain at: https://dashscope-intl.aliyuncs.com → API Keys
DASHSCOPE_API_KEY=sk-your-international-key-here

# DashScope OpenAI-compatible endpoint (international)
# Do NOT change unless Alibaba Cloud changes the endpoint URL
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ------------------------------------------------------------------------------
# Translation model (DashScope catalog)
# ------------------------------------------------------------------------------
# Verified DashScope intl pricing (per 1M tokens, input / output):
#   qwen-mt-turbo     — $0.16 / $0.49   PRIMARY: translation-specialized, 1M ctx
#   qwen-mt-plus      — $2.46 / $7.37   FALLBACK: highest quality MT tier
#   qwen3.5-plus      — $0.40 / $2.40   alias: qwen-plus-latest, fallback if MT models down
#   qwen3-max         — $1.20 / $6.00   AVOID for bulk (10× cost vs turbo, inferior MT)
#
# Glossary support: native `terminology` API param works only with qwen-mt-* models.
# Switching to qwen3.5-plus / qwen3-max disables native glossary injection — fall
# back to prompt-level glossary (see services/glossary_service.py D-02-06 hook).
#
# Default: qwen-mt-turbo. Override per-deployment without code change.
DASHSCOPE_MODEL=qwen-mt-turbo

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://user:password@host:port/dbname
# Default matches docker-compose postgres service
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/aitranslation

# ------------------------------------------------------------------------------
# Redis (arq job queue + SSE pub/sub)
# ------------------------------------------------------------------------------
# Default matches docker-compose redis service
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# File storage
# Per-job layout: .data/jobs/{job_id}/source.{ext}, output.{ext}, segments.json, errors.log
# Gitignored. Docker bind-mounts .data/ → /data inside the container.
# ------------------------------------------------------------------------------
DATA_DIR=/data

# Maximum upload size in bytes (default: 50 MB)
MAX_UPLOAD_BYTES=52428800

# ------------------------------------------------------------------------------
# Translation batching
# Token budget per batch for qwen-mt-turbo (D-07: 2-4K range)
# Tune empirically; default 3000 fits most paragraphs without splitting
# ------------------------------------------------------------------------------
TOKEN_BUDGET=3000

# ------------------------------------------------------------------------------
# Worker concurrency
# Number of concurrent batches per translation job (D-17: cap at 4).
# DashScope intl free tier caps around 60 RPM — stick with 1 unless you've
# upgraded. Bump to 4 on paid tier for parallel batch translation.
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=1

# ------------------------------------------------------------------------------
# DashScope per-call pacing
# Forced sleep after every successful qwen-mt-turbo call (seconds, 0 to disable).
# 1.2s ≈ 50 RPM — safe under free tier. Set to 0 for paid-tier accounts with
# 300+ RPM budgets.
# ------------------------------------------------------------------------------
DASHSCOPE_PACE_SECONDS=1.2

# ------------------------------------------------------------------------------
# Sentinel-batched call size (translator-layer optimization)
# How many unique cells to pack into ONE sentinel-joined API call.
# Each batch reports a count mismatch when the model drops a '|||' between
# adjacent short cells — that batch then falls back to per-segment.
#   10  — default; ~9% mismatch on CJK-heavy table jobs (job 84546d53)
#   25  — aggressive; ~24% mismatch — too lossy for CJK tables
#    5  — conservative; ~4% mismatch — use if your job retries a lot
# ------------------------------------------------------------------------------
DASHSCOPE_BATCH_SIZE=10

# ------------------------------------------------------------------------------
# CORS allowed origins (comma-separated)
# Dev default: http://localhost:3000
# Prod: set to your deployed domain(s), e.g.
#   CORS_ALLOWED_ORIGINS=https://translate.aicorelabs.click
# Note: when frontend + backend are same-origin behind nginx, CORS is not
# triggered. This var is the safety net for direct API access or split-origin
# deployments.
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

ADMIN_EMAIL=admin123@gmail.com
ADMIN_PASSWORD=Admin@123
ADMIN_FULL_NAME=Admin User
SECRET_KEY=change-me-generate-with-secrets-token_urlsafe-64
LICENSE_SIGNING_SECRET=change-me-license-hmac-secret

# ------------------------------------------------------------------------------
# Email / SMTP
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Forma <noreply@example.com>
SMTP_TLS=true
LEAD_NOTIFICATION_TO=sales@example.com,owner@example.com

# Application base URL — used in email links (activate, reset, welcome)
APP_URL=http://localhost:8080