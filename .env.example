# ==============================================================================
# AI Translation PoC — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==============================================================================

# DashScope API — INTERNATIONAL key (dashscope-intl.aliyuncs.com)
# WARNING: China-region key (from dashscope.aliyun.com) returns a cryptic 401
#          with no explanation. Use ONLY the international key.
# Obtain at: https://dashscope-intl.aliyuncs.com → API Keys
DASHSCOPE_API_KEY=sk-your-international-key-here

# DashScope OpenAI-compatible endpoint (international)
# Do NOT change unless Alibaba Cloud changes the endpoint URL
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://user:password@host:port/dbname
# Default matches docker-compose postgres service
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/aitranslation

# ------------------------------------------------------------------------------
# Redis (arq job queue + SSE pub/sub)
# ------------------------------------------------------------------------------
# Default matches docker-compose redis service
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# File storage
# Per-job layout: .data/jobs/{job_id}/source.{ext}, output.{ext}, segments.json, errors.log
# Gitignored. Docker bind-mounts .data/ → /data inside the container.
# ------------------------------------------------------------------------------
DATA_DIR=/data

# Maximum upload size in bytes (default: 50 MB)
MAX_UPLOAD_BYTES=52428800

# ------------------------------------------------------------------------------
# Translation batching
# Token budget per batch for qwen-mt-turbo (D-07: 2-4K range)
# Tune empirically; default 3000 fits most paragraphs without splitting
# ------------------------------------------------------------------------------
TOKEN_BUDGET=3000

# ------------------------------------------------------------------------------
# Worker concurrency
# Number of concurrent batches per translation job (D-17: cap at 4).
# DashScope intl free tier caps around 60 RPM — stick with 1 unless you've
# upgraded. Bump to 4 on paid tier for parallel batch translation.
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=1

# ------------------------------------------------------------------------------
# DashScope per-call pacing
# Forced sleep after every successful qwen-mt-turbo call (seconds, 0 to disable).
# 1.2s ≈ 50 RPM — safe under free tier. Set to 0 for paid-tier accounts with
# 300+ RPM budgets.
# ------------------------------------------------------------------------------
DASHSCOPE_PACE_SECONDS=1.2
